<Window x:Class="LogFilterApp.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LogFilterApp.ViewModels"
        Title="日志过滤器 LogFilter — Unity / 线上日志通用过滤"
        Width="1480" Height="900"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindow}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============ 工具栏 ============ -->
        <Border Grid.Row="0" Background="{DynamicResource BgToolbar}"
                BorderBrush="{DynamicResource BorderWeak}" BorderThickness="0,0,0,1" Padding="8,6">
            <WrapPanel Orientation="Horizontal">
                <Button Classes="toolbar" Content="打开日志文件" Command="{Binding OpenFilesCommand}" />
                <Button Classes="toolbar" Content="粘贴日志" Command="{Binding PasteCommand}" />
                <Button Classes="toolbar" Content="清空" Command="{Binding ClearAllCommand}" />

                <Rectangle Width="1" Height="24" Fill="{DynamicResource BorderWeak}" Margin="6,0" />

                <TextBox Width="300" Watermark="搜索：关键字 / 正则"
                         Text="{Binding SearchText}" VerticalContentAlignment="Center" />
                <CheckBox Content="正则" IsChecked="{Binding UseRegex}" Margin="8,4,8,0" />
                <CheckBox Content="大小写" IsChecked="{Binding CaseSensitive}" Margin="0,4,8,0" />

                <Rectangle Width="1" Height="24" Fill="{DynamicResource BorderWeak}" Margin="6,0" />

                <ToggleButton Classes="level" Content="Log" IsChecked="{Binding ShowLog}"
                              Foreground="#9CDCFE" Margin="0,0,4,0" />
                <ToggleButton Classes="level" Content="Warning" IsChecked="{Binding ShowWarning}"
                              Foreground="#E2C08D" />
                <ToggleButton Classes="level" Content="Error" IsChecked="{Binding ShowError}"
                              Foreground="#F48771" />
                <ToggleButton Classes="level" Content="Exception" IsChecked="{Binding ShowException}"
                              Foreground="#FF6B6B" />
                <ToggleButton Classes="level" Content="Assert" IsChecked="{Binding ShowAssert}"
                              Foreground="#C586C0" Margin="0,0,8,0" />

                <Rectangle Width="1" Height="24" Fill="{DynamicResource BorderWeak}" Margin="0,0,6,0" />

                <Button Classes="toolbar" Content="模块配置" Command="{Binding OpenSettingsCommand}" />
                <Button Classes="toolbar" Content="保存显示配置" Command="{Binding SaveDisplayCommand}" />
                <Button Classes="toolbar" Content="复制可见" Command="{Binding CopyVisibleCommand}" />
                <Button Classes="toolbar" Content="导出" Command="{Binding ExportCommand}" />
            </WrapPanel>
        </Border>

        <!-- ============ 主区域 ============ -->
        <Grid Grid.Row="1" ColumnDefinitions="330,4,*">

            <!-- 左侧：模块筛选 -->
            <Border Grid.Column="0" Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource BorderWeak}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8" Spacing="6">
                        <TextBlock Text="模块 / 标签筛选" FontWeight="Bold" FontSize="13" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="small" Content="全选" Command="{Binding SelectAllModulesCommand}" />
                            <Button Classes="small" Content="反选" Command="{Binding InvertModulesCommand}" />
                            <Button Classes="small" Content="全部展开堆栈" Command="{Binding ShowAllStackCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <ListBox Classes="tags" ItemsSource="{Binding Modules}" Margin="4,0,4,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="2,0">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}"
                                              VerticalAlignment="Center" MinWidth="0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                               VerticalAlignment="Center" Margin="6,0,4,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="dim"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <ToggleButton Grid.Column="3" Classes="stack" Content="栈"
                                                  ToolTip.Tip="在列表中显示该模块的堆栈"
                                                  IsChecked="{Binding ShowStackTrace}"
                                                  VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Button Grid.Column="4" Width="26" Height="22" Padding="0"
                                            ToolTip.Tip="模块颜色" VerticalAlignment="Center">
                                        <Rectangle Fill="{Binding Brush}" Width="18" Height="12" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <ItemsControl ItemsSource="{Binding Palette}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Width="180" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding ApplyCommand}"
                                                                    Width="26" Height="26" Padding="0"
                                                                    Margin="2" Background="Transparent">
                                                                <Rectangle Fill="{Binding Brush}" Width="18" Height="18" />
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Background="{DynamicResource BorderWeak}" ResizeDirection="Columns" />

            <!-- 右侧：日志列表 + 详情 -->
            <Grid Grid.Column="2" RowDefinitions="*,4,220">

                <ListBox Grid.Row="0" Classes="logs" ItemsSource="{Binding VisibleLogs}"
                         SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                         Background="{DynamicResource BgWindow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,3" BorderBrush="#FF2A2A2B" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <Grid ColumnDefinitions="80,34,120,*">
                                        <TextBlock Grid.Column="0" Text="{Binding Time}" Classes="dim"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding LevelText}"
                                                   Foreground="{Binding LevelBrush}" FontSize="10"
                                                   FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding ModuleName}"
                                                   Foreground="{Binding ModuleBrush}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding FirstLine}"
                                                   Foreground="{Binding ModuleBrush}" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <TextBlock Text="{Binding DisplayStack}"
                                               IsVisible="{Binding HasDisplayStack}"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                               Opacity="0.62" Margin="80,1,0,1"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Row="1" Background="{DynamicResource BorderWeak}" ResizeDirection="Rows" />

                <Border Grid.Row="2" Background="{DynamicResource BgPanel}"
                        BorderBrush="{DynamicResource BorderWeak}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6" Spacing="6">
                            <TextBlock Text="详情" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Classes="small" Content="复制本条" Command="{Binding CopySelectedCommand}" />
                        </StackPanel>
                        <ScrollViewer Margin="8,0,8,8">
                            <SelectableTextBlock Text="{Binding DetailText}"
                                                 FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                 TextWrapping="Wrap" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="2" Background="{DynamicResource BgToolbar}"
                BorderBrush="{DynamicResource BorderWeak}" BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="90" Height="14" Margin="8,0,0,0"
                             IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding VisibleCount, StringFormat='显示 {0} 条'}"
                           Classes="dim" VerticalAlignment="Center" Margin="8,0" />
                <TextBlock Text="{Binding StatusText}" Classes="dim" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
